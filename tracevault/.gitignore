# ==============================================================================
# TRACEVAULT — COMPREHENSIVE .GITIGNORE
# Single source of truth for the entire monorepo
# ==============================================================================

# ==============================================================================
# PYTHON / BACKEND
# ==============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py.qual
.hypothesis/
.pytest_cache/
pytestdebug.log

# Jupyter Notebook
.ipynb_checkpoints

# IPython
.ipython/

# Virtual environments
venv/
venv*/
env/
env*/
ENV/
env.bak/
venv.bak/
.venv/

# ==============================================================================
# DATABASES
# ==============================================================================

*.db
*.sqlite
*.sqlite3

# ==============================================================================
# NODE.JS / FRONTEND
# ==============================================================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# Build output
dist/
dist-ssr/
*.local

# Vite
.vite/

# ==============================================================================
# ENVIRONMENT VARIABLES & SECRETS
# ==============================================================================

.env
.env.*
!.env.example

# ==============================================================================
# AUDIO / MEDIA FILES
# ==============================================================================

# Sample / test audio files should not be committed
*.wav
*.mp3
*.m4a
*.aac
*.ogg
*.flac
*.opus
*.amr
*.wma
*.3gp

# ==============================================================================
# STORAGE & UPLOADS
# ==============================================================================

backend/app/storage/uploads/*
!backend/app/storage/uploads/.gitkeep
backend/app/storage/processed/*
!backend/app/storage/processed/.gitkeep
backend/app/storage/reports/*
!backend/app/storage/reports/.gitkeep
backend/app/storage/temp/*
!backend/app/storage/temp/.gitkeep

# ==============================================================================
# LOGS
# ==============================================================================

logs/
*.log

# ==============================================================================
# IDEs & EDITORS
# ==============================================================================

.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.ntvs*
*.njsproj
*.sln
*~

# ==============================================================================
# OS FILES
# ==============================================================================

.DS_Store
Thumbs.db
desktop.ini

# ==============================================================================
# DOCKER
# ==============================================================================

.docker/
