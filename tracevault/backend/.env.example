# TraceVault Backend Configuration Example
APP_NAME=TraceVault
APP_ENV=development
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=replace_with_a_secure_random_secret_key_32_bytes

# Database Configuration (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./test.db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tracevault
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_postgres_password

# Redis Caching & Task Broker
REDIS_URL=redis://localhost:6379/0

# Security & JWT Token Rotation
JWT_SECRET=replace_with_jwt_access_secret_key
JWT_REFRESH_SECRET=replace_with_jwt_refresh_secret_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
AES_SECRET_KEY=replace_with_32_byte_aes_encryption_key!

# LLM & AI Copilot Integration (Supports Gemini / OpenAI / Local Ollama)
GEMINI_API_KEY=your_gemini_api_key_here
LLM_API_KEY=your_llm_api_key_here

# CORS Configuration
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Open Source AI Pipeline Models
WHISPER_MODEL_SIZE=large-v3
GLINER_MODEL_NAME=knowledgator/gliner-multitask-large-v0.5
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
