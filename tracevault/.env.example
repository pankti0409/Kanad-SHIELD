# ==============================================================================
# TRACEVAULT ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ==============================================================================

# Application
APP_ENV=development
APP_NAME=TraceVault
APP_VERSION=1.0.0
LOG_LEVEL=INFO
SECRET_KEY=change-this-to-a-very-long-random-secret-key-minimum-64-chars

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=tracevault
POSTGRES_USER=tracevault
POSTGRES_PASSWORD=change-this-strong-password
DATABASE_URL=postgresql+asyncpg://tracevault:change-this-strong-password@postgres:5432/tracevault

# JWT
JWT_SECRET=change-this-jwt-secret-minimum-64-chars-random-string
JWT_REFRESH_SECRET=change-this-refresh-secret-minimum-64-chars-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Encryption
AES_SECRET_KEY=change-this-aes-key-must-be-32-chars

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Qdrant (Vector Database)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333

# Ollama (Local LLM)
OLLAMA_HOST=ollama
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# HuggingFace (for pyannote.audio)
HF_TOKEN=your-huggingface-token-here

# Storage
UPLOAD_DIRECTORY=/app/storage/uploads
PROCESSED_DIRECTORY=/app/storage/processed
REPORT_DIRECTORY=/app/storage/reports
TEMP_DIRECTORY=/app/storage/temp
MAX_UPLOAD_SIZE_MB=500
ALLOWED_AUDIO_FORMATS=wav,mp3,m4a,aac,ogg,flac,opus

# AI Model Settings
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=float16
EMBEDDING_MODEL=BAAI/bge-m3
EMOTION_MODEL=speechbrain/emotion-recognition-wav2vec2-IEMOCAP
NER_MODEL=knowledgator/gliner-multitask-large-v0.5

# Frontend
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_BASE_URL=ws://localhost:8000
VITE_APP_NAME=TraceVault

# Nginx
NGINX_HOST=0.0.0.0
NGINX_PORT=80
NGINX_HTTPS_PORT=443

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=10

# Email (future)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@tracevault.gov
